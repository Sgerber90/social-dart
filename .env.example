# Optional accounts & groups (Firebase web config is public by design; security comes from firestore.rules).
# Leave empty for guest-only mode. Set VITE_ACCOUNTS=off to switch accounts off even when configured.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_ACCOUNTS=
